{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:speech-to-text",
  "visibility": "public",
  "url": "https://github.com/viam-labs/speech-to-text",
  "description": "Speech-to-text components: google-cloud-stt + session-sensor capture",
  "models": [
    {
      "api": "rdk:component:generic",
      "model": "viam:speech-to-text:google-cloud-stt",
      "markdown_link": "viam_speech-to-text_google-cloud-stt.md#model-viamspeech-to-textgoogle-cloud-stt",
      "short_description": "Streams audio from an audio_in source to Google Cloud STT and dispatches final transcripts."
    },
    {
      "api": "rdk:component:sensor",
      "model": "viam:speech-to-text:session-sensor",
      "markdown_link": "viam_speech-to-text_session-sensor.md#model-viamspeech-to-textsession-sensor",
      "short_description": "Queues per-session capture records and uploads the corresponding WAV to Viam's binary store."
    }
  ],
  "applications": null,
  "markdown_link": "README.md",
  "entrypoint": "bin/speech-to-text",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64"
    ]
  }
}
